{"id":"tmf8821","name":"TMF8821","vendor":"ams OSRAM","description":"Configurable 3x3, 4x4 or 3x6-zone direct ToF (1 cm to 5 m, up to 63° diagonal FoV) in a 4.6 x 2.0 mm OLGA module. Wide-angle obstacle mapping and gap finding for small robots over I²C.","form":"ic","device":"tof-multizone","variants":[{"partNumber":"TMF8821-1AM","package":"LGA-12","pins":12,"bodyMm":[4.6,2],"pitchMm":0.82,"heightMm":1.4,"note":"7-inch tape & reel, 500 pcs","lcsc":"C17253284","priceUsd":7.73,"kicadSymbol":"Sensor_Distance:TMF8821","kicadFootprint":"Sensor_Distance:AMS_OLGA12","kicad":{"officialSymbol":{"ref":"Sensor_Distance:TMF8821","url":"https://gitlab.com/api/v4/projects/kicad%2Flibraries%2Fkicad-symbols/repository/files/Sensor_Distance.kicad_symdir%2FTMF8821.kicad_sym/raw?ref=45efbd93be87e365a21d743daf9b8a07e6414df6"},"officialFootprint":{"ref":"Sensor_Distance:AMS_OLGA12","url":"https://gitlab.com/api/v4/projects/kicad%2Flibraries%2Fkicad-footprints/repository/files/Sensor_Distance.pretty%2FAMS_OLGA12.kicad_mod/raw?ref=a0dcd398e7ea4b00cdeb91efc35f09cceaa9097d"},"footprintNote":"LGA-12: use the official/vendor footprint","pinout":true},"buy":[{"store":"LCSC","url":"https://www.lcsc.com/product-detail/C17253284.html","priceUsd":7.73},{"store":"DigiKey","url":"https://www.digikey.com/en/products/result?keywords=TMF8821-1AM"},{"store":"Mouser","url":"https://www.mouser.com/c/?q=TMF8821-1AM"},{"store":"JLCPCB parts","url":"https://jlcpcb.com/parts/componentSearch?searchTxt=C17253284"},{"store":"Octopart","url":"https://octopart.com/search?q=TMF8821-1AM"}]},{"partNumber":"TMF8821-1A","package":"LGA-12","pins":12,"bodyMm":[4.6,2],"pitchMm":0.82,"heightMm":1.4,"note":"13-inch tape & reel, 4000 pcs","kicadSymbol":"Sensor_Distance:TMF8821","kicadFootprint":"Sensor_Distance:AMS_OLGA12","kicad":{"officialSymbol":{"ref":"Sensor_Distance:TMF8821","url":"https://gitlab.com/api/v4/projects/kicad%2Flibraries%2Fkicad-symbols/repository/files/Sensor_Distance.kicad_symdir%2FTMF8821.kicad_sym/raw?