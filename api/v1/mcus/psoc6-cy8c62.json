{"id":"psoc6-cy8c62","name":"PSoC 62 (CY8C62xx)","vendor":"Infineon","family":"PSoC 6","description":"Dual-core 150 MHz Cortex-M4F + Cortex-M0+ with up to 2 MB flash / 1 MB SRAM, CapSense touch, USB FS, SD host, QSPI XIP and crypto; a low-power, touch-capable MCU for IoT. It has no radio.","core":"Arm Cortex-M4F + Cortex-M0+","arch":"arm","cores":2,"maxMhz":150,"fpu":"sp","flashKB":2048,"externalFlashMaxMB":128,"ramKB":1024,"psramMaxMB":0,"voltage":{"min":1.7,"max":3.6},"supply5V":false,"peripherals":{"gpio":102,"uart":12,"i2c":13,"spi":9,"i2s":2,"can":1,"canFd":1,"usb":1,"usbHost":true,"usbHighSpeed":false,"usbPd":false,"ethernet":0,"sdio":2,"qspi":true,"adcChannels":16,"adcBits":12,"dacChannels":1,"pwmChannels":32,"touchChannels":101,"rtc":true,"lcd":true,"camera":false,"pio":false,"crypto":true},"wireless":{"wifi":"none","wifi5GHz":false,"ble":null,"btClassic":false,"thread":false,"zigbee":false,"matter":false,"subGhz":false,"lora":false,"cellular":"none","nfc":false},"lowPower":{"deepSleepUa":7,"activeUaPerMhz":40},"ecosystem":{"arduino":true,"micropython":false,"circuitpython":false,"rust":false,"zephyr":true,"platformio":false,"vendorSdk":"ModusToolbox"},"programming":{"usbBootloader":false,"uartBootloader":false,"debug":["SWD","JTAG"],"needsProgrammer":true},"variants":[{"partNumber":"CY8C624ABZI-S2D44","package":"BGA-124","pins":124,"bodyMm":[9,9],"pitchMm":0.65,"heightMm":1,"flashKB":2048,"ramKB":1024,"gpio":100,"lcsc":"C5370259","priceUsd":14.5,"kicad":{"footprintNote":"BGA-124: use the official/vendor footprint","pinout":false},"buy":[{"store":"LCSC","url":"https://www.lcsc.com/product-detail/C5370259.html","priceUsd":14.5},{"store":"DigiKey","url":"https://www.digikey.com/en/products/result?keywords=CY8C624ABZI-S2D44"},{"store":"Mouser","url":"https://www.mouser.com/c/?q=CY8C624ABZI-S2D44"},{"store":"JLCPCB parts","url":"https://jlcpcb.com/parts/componentSearch?searchTxt=C5370259"},{"store":"Octopart","url":"https://octopart.com/search?q=CY8C624ABZI-S2D4