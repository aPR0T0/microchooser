.html"],"boards":["adafruit-feather-rp2350","adafruit-metro-rp2350","waveshare-rp2350-zero","pimoroni-tiny-2350","pimoroni-pico-plus-2","pico-2","pico-2-w","xiao-rp2350","sparkfun-pro-micro-rp2350"]}