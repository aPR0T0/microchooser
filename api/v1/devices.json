{"categories":[{"key":"communication","label":"Buses & networking"},{"key":"usb","label":"USB"},{"key":"storage","label":"Storage"},{"key":"display","label":"Displays & LEDs"},{"key":"sensor","label":"Sensors"},{"key":"actuator","label":"Motors & outputs"},{"key":"input","label":"Buttons & input"},{"key":"wireless","label":"External radios"},{"key":"power","label":"Power"}],"devices":[{"id":"canfd-transceiver","name":"CAN-FD transceiver","category":"communication","examples":"TCAN1042, TJA1443, MCP2562FD","needs":{"canFd":1}},{"id":"can-transceiver","name":"CAN 2.0 transceiver","category":"communication","examples":"TJA1051, SN65HVD230","needs":{"can":1}},{"id":"obd2","name":"OBD-II port (CAN)","category":"communication","examples":"car diagnostics","needs":{"can":1}},{"id":"rs485","name":"RS-485 / Modbus transceiver","category":"communication","examples":"MAX3485, THVD1450","needs":{"uart":1,"gpio":1},"note":"1 GPIO for driver enable."},{"id":"lin","name":"LIN transceiver","category":"communication","examples":"TJA1021","needs":{"uart":1}},{"id":"ethernet","name":"Ethernet port (RMII PHY)","category":"communication","examples":"LAN8720, RJ45","needs":{"ethernet":1}},{"id":"serial-device","name":"Generic UART device","category":"communication","examples":"another MCU, RS-232 level shifter","needs":{"uart":1}},{"id":"isolated-can","name":"Isolated CAN / CAN-FD transceiver","category":"communication","examples":"ISO1042, ADM3055E, CA-IF1042","needs":{"canFd":1},"note":"Needs an isolated supply on the bus side (or a part with one built in)."},{"id":"isolated-rs485","name":"Isolated RS-485 transceiver","category":"communication","examples":"ADM2587E, ISO1410, ISOW1412","needs":{"uart":1,"gpio":1}},{"id":"can-spi","name":"SPI CAN-FD controller","category":"communication","examples":"MCP2518FD, MCP251863, TCAN4550","needs":{"spiDev":1,"gpio":1},"note":"Adds a CAN-FD bus to any MCU with SPI (1 GPIO for the interrupt)."},{"id":"ethernet-spi","name":"SPI Ethernet controller","category":"communication","examples":"W5500, ENC28J60, W6100","needs":{"spiDev":1,"gpio":2},"note":"INT + RST pins."},{"id":"ethercat","name":"EtherCAT slave controller (SPI)","category":"communication","examples":"LAN9252, AX58100, ET1100","needs":{"spiDev":1,"gpio":3},"note":"IRQ + SYNC0/SYNC1 pins; the ESC handles the real-time frames."},{"id":"servo-bus","name":"Smart-servo bus (half-duplex)","category":"communication","examples":"Dynamixel, Feetech STS, LX-16A","needs":{"uart":1,"gpio":1},"note":"1 GPIO for the direction pin of the half-duplex buffer or RS-485 transceiver."},{"id":"usb-uart","name":"USB-to-UART bridge","category":"communication","examples":"CH340C, CP2102N, FT232RL","needs":{"uart":1}},{"id":"usb-device","name":"USB port to a computer","category":"usb","examples":"USB-C device: HID, CDC serial, MIDI, MSC","needs":{"usb":1}},{"id":"usb-host-port","name":"USB host port","category":"usb","examples":"keyboard, flash drive, MIDI controller","needs":{"usb":1,"flags":{"usbHost":true}}},{"id":"usb-hub","name":"USB hub (MCU behind a hub)","category":"usb","examples":"USB2514B, CH334","needs":{"usb":1},"note":"The hub chip is external; the MCU needs one USB device link."},{"id":"usb-hs","name":"High-speed USB link (480 Mbit/s)","category":"usb","examples":"fast logging, USB audio, UVC","needs":{"usb":1,"flags":{"usbHighSpeed":true}}},{"id":"usb-pd","name":"USB-C Power Delivery negotiation","category":"usb","examples":"9–20 V from a USB-C charger","needs":{"flags":{"usbPd":true}},"note":"Or use an external PD sink chip (CH224K, HUSB238) over I²C/GPIO."},{"id":"microsd","name":"microSD card","category":"storage","examples":"data logging, audio files","needs":{"sdCard":true}},{"id":"spi-flash","name":"SPI NOR flash","category":"storage","examples":"W25Q128","needs":{"spiDev":1}},{"id":"eeprom","name":"I²C EEPROM / FRAM","category":"storage","examples":"24LC256, MB85RC256","needs":{"i2cDev":1}},{"id":"oled-i2c","name":"OLED 128×64 (I²C)","category":"display","examples":"SSD1306, SH1106","needs":{"i2cDev":1}},{"id":"tft-spi","name":"Color TFT (SPI)","category":"display","examples":"ST7789, ILI9341 240×320","needs":{"spiDev":1,"gpio":2},"note":"DC + RST pins."},{"id":"epaper","name":"E-paper display (SPI)","category":"display","examples":"Waveshare 2.9\"","needs":{"spiDev":1,"gpio":3}},{"id":"lcd-rgb","name":"Parallel RGB LCD 800×480","category":"display","examples":"ESP32-S3 / P4 style panels","needs":{"flags":{"lcd":true,"psram":true}}},{"id":"lcd-char","name":"16×2 character LCD (I²C backpack)","category":"display","examples":"HD44780 + PCF8574","needs":{"i2cDev":1}},{"id":"led-matrix","name":"LED matrix / 7-seg (SPI)","category":"display","examples":"MAX7219","needs":{"spiDev":1}},{"id":"neopixel","name":"Addressable LED strip","category":"display","examples":"WS2812B / NeoPixel / SK6812","needs":{"gpio":1}},{"id":"led","name":"Status LED","category":"display","examples":"indicator","needs":{"gpio":1}},{"id":"rgb-led","name":"RGB LED (PWM)","category":"display","examples":"common-anode RGB","needs":{"pwmChannels":3}},{"id":"env-sensor","name":"Temp / humidity / pressure","category":"sensor","examples":"BME280, SHT40, AHT20","needs":{"i2cDev":1}},{"id":"imu","name":"IMU / accelerometer","category":"sensor","examples":"MPU-6050, ICM-42688, LSM6DS3","needs":{"i2cDev":1}},{"id":"imu-spi","name":"High-rate IMU (SPI)","category":"sensor","examples":"ICM-42688-P, BMI270 for flight control","needs":{"spiDev":1,"gpio":1}},{"id":"gps","name":"GPS / GNSS module","category":"sensor","examples":"u-blox M10, NEO-6M, ATGM336H","needs":{"uart":1}},{"id":"current-i2c","name":"Current / power monitor (I²C)","category":"sensor","examples":"INA219, INA226","needs":{"i2cDev":1}},{"id":"analog-sensor","name":"Analog sensor / potentiometer","category":"sensor","examples":"LDR, soil moisture, joystick axis","needs":{"adcChannels":1}},{"id":"thermistor","name":"Thermistor (NTC)","category":"sensor","examples":"100k NTC on a hot-end","needs":{"adcChannels":1}},{"id":"thermocouple","name":"Thermocouple amp (SPI)","category":"sensor","examples":"MAX31855, MAX6675","needs":{"spiDev":1}},{"id":"tof","name":"ToF distance sensor","category":"sensor","examples":"VL53L0X, VL53L1X, VL53L4CD","needs":{"i2cDev":1,"gpio":1},"note":"1 GPIO for XSHUT so several sensors can share the bus with different addresses."},{"id":"tof-multizone","name":"Multizone ToF (8×8)","category":"sensor","examples":"VL53L5CX, VL53L7CX, TMF8821","needs":{"i2cDev":1,"gpio":2},"note":"LPn + INT pins. The ST driver uploads an ~80 KB firmware image from MCU flash at boot."},{"id":"lidar-1d","name":"Single-point LiDAR","category":"sensor","examples":"TF-Luna, TFmini-S, TF02-Pro","needs":{"uart":1},"note":"Most also speak I²C; use UART at 115200 baud for the full frame rate."},{"id":"lidar-2d","name":"360° 2D LiDAR scanner","category":"sensor","examples":"RPLIDAR C1, LD19, YDLIDAR X2","needs":{"uart":1},"note":"115200–460800 baud: use a hardware UART. Scanners with a motor-speed pin (RPLIDAR A1/A2, some YDLIDARs) also want 1 PWM."},{"id":"ultrasonic","name":"Ultrasonic distance","category":"sensor","examples":"HC-SR04","needs":{"gpio":2}},{"id":"one-wire","name":"1-Wire / DHT sensor","category":"sensor","examples":"DS18B20, DHT22","needs":{"gpio":1}},{"id":"load-cell","name":"Load cell amplifier","category":"sensor","examples":"HX711","needs":{"gpio":2}},{"id":"camera","name":"Camera module (DVP)","category":"sensor","examples":"OV2640, OV5640, GC2145","needs":{"flags":{"camera":true,"psram":true}}},{"id":"camera-mipi","name":"MIPI CSI-2 camera","category":"sensor","examples":"IMX219, IMX708, OV5647","needs":{"flags":{"mipiCsi":true,"psram":true}},"note":"Few MCUs have MIPI CSI-2 (ESP32-P4, STM32N6, i.MX RT1170). Most robots put these on a Raspberry Pi or Jetson."},{"id":"camera-spi","name":"SPI camera (with frame buffer)","category":"sensor","examples":"Arducam Mini 2MP/5MP Plus","needs":{"spiDev":1,"i2cDev":1},"note":"The module buffers and