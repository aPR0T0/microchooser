"Rotary encoder","category":"input","examples":"EC11 with push","needs":{"gpio":3}},{"id":"keypad","name":"4×4 keypad","category":"input","examples":"membrane keypad","needs":{"gpio":8}},{"id":"key-matrix","name":"Keyboard matrix (5×15)","category":"input","examples":"60–65% keyboard","needs":{"gpio":20}},{"id":"touch-pad","name":"Capacitive touch pad","category":"input","examples":"PCB touch button","needs":{"touchChannels":1}},{"id":"ir-receiver","name":"IR receiver","category":"input","examples":"VS1838B","needs":{"gpio":1}},{"id":"lora-module","name":"LoRa module (SPI)","category":"wireless","examples":"SX1262, RFM95W, E22","needs":{"spiDev":1,"gpio":2}},{"id":"nrf24","name":"nRF24L01 radio (SPI)","category":"wireless","examples":"2.4 GHz link","needs":{"spiDev":1,"gpio":1}},{"id":"cell-modem","name":"Cellular modem (UART)","category":"wireless","examples":"SIM7600, SIM800L, BG95","needs":{"uart":1,"gpio":2}},{"id":"bt-serial","name":"Bluetooth serial module","category":"wireless","examples":"HC-05","needs":{"uart":1}},{"id":"battery-monitor","name":"Battery voltage monitor","category":"power","examples":"divider on a LiPo","needs":{"adcChannels":1}},{"id":"charger-standalone","name":"Battery charger (status pins)","category":"power","examples":"MCP73831, TP4056, BQ24074","needs":{"gpio":2},"note":"CHG/PG status pins to the MCU (optional — they can drive LEDs instead)."},{"id":"charger-i2c","name":"I²C battery charger / power-path","category":"power","examples":"BQ25895, BQ24295, BQ25601","needs":{"i2cDev":1,"gpio":1},"note":"INT pin to the MCU."},{"id":"buck","name":"Buck converter with enable / power-good","category":"power","examples":"TPS54202, AP63203, TPS62933","needs":{"gpio":2},"note":"EN + PG to the MCU (optional — tie EN to VIN for always-on)."},{"id":"dc-input-12v","name":"12 V DC input","category":"power","examples":"barrel jack + buck to 5 V / 3.3 V","needs":{},"note":"No MCU pins needed — add a buck regulator (e.g. TPS54202) to make 5 V and 3.3 V."